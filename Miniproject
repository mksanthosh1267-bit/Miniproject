const express = require('express');
const multer  = require('multer');
const bodyParser = require('body-parser');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;

// Ensure uploads dir and submissions file exist
const UPLOAD_DIR = path.join(__dirname, 'uploads');
const SUBMISSIONS_FILE = path.join(__dirname, 'submissions.json');

if (!fs.existsSync(UPLOAD_DIR)) fs.mkdirSync(UPLOAD_DIR, { recursive: true });
if (!fs.existsSync(SUBMISSIONS_FILE)) fs.writeFileSync(SUBMISSIONS_FILE, '[]', 'utf8');

// Simple JSON read/write helpers
function loadSubmissions() {
  try {
    return JSON.parse(fs.readFileSync(SUBMISSIONS_FILE, 'utf8') || '[]');
  } catch (e) {
    return [];
  }
}
function saveSubmissions(list) {
  fs.writeFileSync(SUBMISSIONS_FILE, JSON.stringify(list, null, 2), 'utf8');
}

// Multer storage and file validation
const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, UPLOAD_DIR),
  filename: (req, file, cb) => {
    // Use timestamp + sanitized original name
    const ts = Date.now();
    const safeName = file.originalname.replace(/\s+/g, '').replace(/[^a-zA-Z0-9\.-]/g, '');
    cb(null, ${ts}_${safeName});
  }
});

const upload = multer({
  storage,
  limits: { fileSize: 10 * 1024 * 1024 }, // 10 MB limit
  fileFilter: (req, file, cb) => {
    // Accept pdf, doc, docx, zip, pptx
    const allowed = /\.(pdf|docx?|zip|pptx?)$/i;
    if (!allowed.test(file.originalname)) {
      return cb(new Error('Only PDF, DOC/DOCX, ZIP, PPT/PPTX files are allowed'));
    }
    cb(null, true);
  }
}).single('projectFile');

app.use(bodyParser.urlencoded({ extended: true }));

// Serve uploaded files for download (protect in production)
app.use('/uploads', express.static(UPLOAD_DIR));

